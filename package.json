{
    "name": "spicy-online",
    "version": "1.0.0",
    "type": "module",
    "engines": {
        "node": "^22.12.0 || >=24.0.0"
    },
    "scripts": {
        "dev": "vite --host 0.0.0.0",
        "build": "vite build",
        "preview": "vite preview --host 0.0.0.0",
        "deploy": "npm run build && wrangler deploy",
        "test": "npm run test:worker && npm run test:client",
        "test:worker": "vitest run --config vitest.config.js",
        "test:client": "vitest run --config vitest.client.config.js"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "^1.68.0",
        "@cloudflare/vitest-plugin": "^1.6.1",
        "jsdom": "^28.1.0",
        "vite": "^7.3.8",
        "vitest": "^4.1.12",
        "wrangler": "^4.159.0"
    }
}
