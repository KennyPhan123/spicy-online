{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "spicy-online",
    "main": "./worker/index.js",
    "compatibility_date": "2026-07-30",
    "assets": {
        "binding": "ASSETS",
        "run_worker_first": ["/api/*"]
    },
    "durable_objects": {
        "bindings": [
            { "name": "GAME_ROOMS", "class_name": "GameRoom" }
        ]
    },
    "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["GameRoom"] }
    ]
}
